# Dependencies
node_modules/

# Memory MCP server runtime state — never commit actual project memory
.copilot-memory/

# Jira/Confluence tool credentials for local script development/testing before deploy —
# tools/.env.example (placeholders only) stays committed, tools/.env (real values) never does
tools/.env

# Claude-authored docs (design notes, test checklists, etc.) — not version-controlled
claudedocs/

# Root-level Docker verification harness (deploy/uninstall round-trip testing) — local-only,
# not version-controlled. Anchored to repo root so it doesn't affect memory-mcp-server/test/,
# which is a real, committed test suite.
/test/

# OS/editor cruft
.DS_Store
Thumbs.db
